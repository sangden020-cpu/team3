<?xml version="1.0"?>

<sdf version="1.8">

    <model name="wood_board">

        <static>true</static>

        <link name="board_link">

            <!-- ============================= -->
            <!-- Visual                         -->
            <!-- ============================= -->

            <visual name="board_visual">

                <geometry>

                    <box>
                        <size>
                            0.50 0.50 0.01
                        </size>
                    </box>

                </geometry>

                <material>

                    <ambient>
                        0.02 0.02 0.02 1
                    </ambient>

                    <diffuse>
                        0.02 0.02 0.02 1
                    </diffuse>

                </material>

            </visual>


            <!-- ============================= -->
            <!-- Collision                       -->
            <!-- ============================= -->

            <collision name="board_collision">

                <geometry>

                    <box>
                        <size>
                            0.50 0.50 0.01
                        </size>
                    </box>

                </geometry>

            </collision>

        </link>

    </model>

</sdf>